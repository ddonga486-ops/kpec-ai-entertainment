{
  "name": "kpec-ai-entertainment",
  "main": "./worker.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kpec-ai-db",
      "database_id": "e0e26afe-49f5-4cce-88be-410199fa20e3"
    }
  ]
}
